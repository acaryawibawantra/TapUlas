# Supabase Connection (Dapatkan dari Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Google Places API Key (Dapatkan dari Google Cloud Console > APIs & Services > Credentials)
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# Base URL Aplikasi (Saat testing lokal gunakan IP laptop/WiFi agar HP bisa akses, misal: http://192.168.1.5:3000)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
